{
	"name": "@fractaldesign/fractalsvelte-ui-gpui",
	"version": "0.2.0",
	"description": "Fractalsvelte UI components for GPUI via gpuix-fractalsvelte: the canonical class-token stylesheet served through the renderer's stylesheet loader, components re-landed for GPUI's element set.",
	"type": "module",
	"license": "MIT",
	"author": "Fractalmandala",
	"keywords": [
		"svelte",
		"svelte5",
		"gpui",
		"gpuix",
		"components",
		"ui",
		"design-system",
		"design-tokens"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"exports": {
		".": "./src/lib/index.ts",
		"./css": "./src/lib/styles/index.css",
		"./styles/*": "./src/lib/styles/*",
		"./theme": "./src/lib/theme/theme.ts",
		"./components/*": "./src/lib/components/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"gpuix-fractalsvelte": ">=0.5.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"svelte": "^5.57.1",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractalsvelte-ui-gpui.git"
	},
	"homepage": "https://github.com/fractalmandala/fractalsvelte-ui-gpui#readme",
	"bugs": {
		"url": "https://github.com/fractalmandala/fractalsvelte-ui-gpui/issues"
	},
	"files": [
		"src",
		"scripts",
		"demo",
		"README.md",
		"AGENTS.md",
		"!demo/*.png"
	]
}
